---
import Base from "./Base.astro";
import LeftNav from "../components/LeftNav.astro";

interface Partner {
  group: string;
  names: string;
}
interface Props {
  title: string;
  dek: string;
  myRole: string;
  corePartners: Partner[];
  timeframe: string;
  sections: { id: string; label: string }[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const {
  title,
  dek,
  myRole,
  corePartners,
  timeframe,
  sections,
  prev,
  next,
} = Astro.props;
---
<Base title={`${title} — Lindsey Liang`} description={dek}>
  <article class="cs">
    <header class="cs-hero">
      <h1 class="cs-hero-title">{title}</h1>
      <dl class="cs-meta">
        {myRole && (
          <div class="cs-meta-row">
            <dt class="cs-meta-key cs-meta-anchor">My Role</dt>
            <dd class="cs-meta-val">{myRole}</dd>
          </div>
        )}

        {corePartners && corePartners.length > 0 && (
          <div class="cs-meta-block">
            <div class="cs-meta-row">
              <dt class="cs-meta-key cs-meta-anchor">Core Partners</dt>
              <dd class="cs-meta-val cs-meta-spacer" />
            </div>
            {corePartners.map((p) => (
              <div class="cs-meta-row">
                <dt class="cs-meta-key">{p.group}</dt>
                <dd class="cs-meta-val cs-meta-name">{p.names}</dd>
              </div>
            ))}
          </div>
        )}

        {timeframe && (
          <div class="cs-meta-row">
            <dt class="cs-meta-key cs-meta-anchor">Timeframe</dt>
            <dd class="cs-meta-val">{timeframe}</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="hero"><slot name="hero" /></div>

    <div class="cs-layout">
      <aside class="cs-aside">
        <LeftNav sections={sections} />
      </aside>
      <div class="cs-body">
        <div class="content"><slot /></div>
      </div>
    </div>

    <nav class="cs-foot">
      {prev ? <a href={prev.href}>← {prev.title}</a> : <span />}
      <a href="/">All work</a>
      {next ? <a href={next.href}>{next.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style is:global>
  .cs { max-width: var(--page-max); margin: 0 auto; padding: var(--s-12) var(--s-4); overflow-x: clip; }

  /* Title hero — two-column wide layout: title on the left, metadata grid on the right. */
  .cs-hero {
    width: min(100vw - 64px, 1216px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-8);
    align-items: center;
    margin-bottom: var(--s-16);
  }
  .cs-hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 66px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 12ch;
  }

  /* Metadata grid (right column). Each row is its own grid for tab alignment. */
  .cs-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .cs-meta-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cs-meta-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    column-gap: var(--s-3);
  }
  .cs-meta-key {
    margin: 0;
    font-weight: 400;
    white-space: nowrap;
  }
  .cs-meta-key.cs-meta-anchor { font-weight: 600; }
  .cs-meta-val {
    margin: 0;
    font-weight: 400;
  }
  .cs-meta-name {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
  }
  .cs-meta-spacer { min-height: 0; }

  .hero { margin-bottom: var(--s-8); }
  .hero:empty { display: none; }

  /* Body layout: LeftNav as sticky aside, body grid for content + margin.
     align-items defaults to stretch so .cs-aside takes the full body height,
     giving its inner sticky LeftNav room to travel with scroll. */
  .cs-layout {
    display: flex;
    justify-content: center;
    column-gap: var(--col-gutter);
  }
  .cs-aside {
    flex: 0 0 var(--col-left);
  }
  .cs-body {
    flex: 0 1 calc(var(--col-center) + var(--col-gutter) + var(--col-right));
    display: grid;
    grid-template-columns: var(--col-center) var(--col-right);
    column-gap: var(--col-gutter);
    align-items: start;
  }
  .cs-body .content { display: contents; }
  .cs-body .content > * { grid-column: 1; }
  .cs-body .content > .margin { grid-column: 2; }

  .cs-body h2 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: var(--s-12) 0 var(--s-3);
  }
  .cs-body h2:first-child { margin-top: 0; }
  .cs-body h3 { font-size: var(--fs-h3); margin: var(--s-6) 0 var(--s-2); }
  .cs-body p { margin-bottom: var(--s-3); }

  .cs-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--s-3);
    margin-top: var(--s-16);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: var(--fs-margin);
  }
  .cs-foot a { text-decoration: none; }
  .cs-foot a:nth-child(1) { justify-self: start; }
  .cs-foot a:nth-child(2) { justify-self: center; color: var(--ink-muted); }
  .cs-foot a:nth-child(3) { justify-self: end; }

  /* Stack title + metadata at narrower widths; hide LeftNav. */
  @media (max-width: 1199px) {
    .cs-hero {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .cs-hero-title { max-width: none; }
    .cs-aside { display: none; }
    .cs-body { flex: 1 1 auto; }
  }
  @media (max-width: 767px) {
    .cs-meta-row { grid-template-columns: 110px 1fr; column-gap: var(--s-2); }
    .cs-body { grid-template-columns: 1fr; }
    .cs-body .content > .margin {
      grid-column: 1;
      border-left: 2px solid var(--rule);
      padding-left: var(--s-2);
      margin: var(--s-3) 0;
    }
  }
</style>
