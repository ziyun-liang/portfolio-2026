---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  credit?: string;
  fullBleed?: boolean;
  wide?: boolean;
  placeholder?: boolean;
  ratio?: string;
}
const {
  src,
  alt,
  caption,
  credit,
  fullBleed = false,
  wide = false,
  placeholder = false,
  ratio = "16 / 10",
} = Astro.props;
const variantClass = wide ? "wide" : fullBleed ? "full-bleed" : "inline";
---
<figure class={variantClass}>
  {placeholder ? (
    <div class="placeholder" style={`aspect-ratio: ${ratio};`}>
      <span class="placeholder-tag">image</span>
      <span class="placeholder-label">{alt}</span>
    </div>
  ) : (
    <img src={src} alt={alt} loading="lazy" />
  )}
  {(caption || credit) && (
    <figcaption>
      {caption && <span class="caption">{caption}</span>}
      {credit && <span class="credit">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  figure { margin: var(--s-6) 0; }
  figure.inline img { border-radius: var(--radius-sm); }
  figure.full-bleed { margin-left: calc(-1 * var(--s-6)); margin-right: calc(-1 * var(--s-6)); }

  /* Wide figure: near-full-bleed with 32px buffer on each side, caption stays at body-column position.
     The cs-body is offset to the right of the cs-aside (TOC), so we shift the
     figure further left by half the aside track to land it on viewport center. */
  figure.wide {
    --bleed-w: min(100vw - 64px, 1216px);
    --aside-offset: calc((var(--col-left) + var(--col-gutter)) / 2);
    grid-column: 1 / -1;
    width: var(--bleed-w);
    margin-left: calc((100% - var(--bleed-w)) / 2 - var(--aside-offset));
    display: grid;
    /* Mirror the page layout so caption can align to body column */
    grid-template-columns:
      minmax(0, 1fr)                        /* inner left padding */
      var(--col-left)                       /* TOC track */
      var(--col-gutter)                     /* gutter */
      var(--col-center)                     /* body column */
      var(--col-gutter)                     /* gutter */
      var(--col-right)                      /* margin column */
      minmax(0, 1fr);                       /* inner right padding */
  }
  figure.wide > img,
  figure.wide > .placeholder {
    grid-column: 1 / -1;                    /* image goes full bleed */
    width: 100%;
    border-radius: 0;
  }
  figure.wide > figcaption {
    grid-column: 4;                         /* caption sits in body column */
    max-width: 320px;
  }

  figcaption {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-margin);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .credit { white-space: nowrap; }
  .placeholder {
    width: 100%;
    background: #C6D3D2;
    border: 1px dashed #9AA8A7;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-4);
    text-align: center;
  }
  .placeholder-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .placeholder-label {
    font-family: var(--font-sans);
    font-size: var(--fs-margin);
    color: var(--ink);
    max-width: 50ch;
    line-height: var(--lh-normal);
  }

  /* Tablet: 2-column grid (no TOC) — caption aligns to body column. Reset
     the aside-offset since the aside is hidden below this breakpoint. */
  @media (max-width: 1199px) {
    figure.wide {
      --aside-offset: 0px;
      grid-template-columns:
        minmax(0, 1fr)
        var(--col-center)
        var(--col-gutter)
        var(--col-right)
        minmax(0, 1fr);
    }
    figure.wide > figcaption {
      grid-column: 2;
    }
  }

  /* Mobile: single content column with small gutters */
  @media (max-width: 767px) {
    figure.wide {
      grid-template-columns: 0 1fr 0;
    }
    figure.wide > figcaption {
      grid-column: 2;
      max-width: 100%;
    }
  }
</style>
