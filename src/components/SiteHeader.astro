---
const path = Astro.url.pathname;
const isWork = path === "/" || path.startsWith("/work");
const isAbout = path.startsWith("/about");

const caseStudies = [
  { href: "/work/nyt-search", label: "AI-Powered Search" },
  { href: "/work/summary", label: "AI Summary" },
  { href: "/work/advertising", label: "Advertising" },
];
---
<header class="site-header">
  <div class="inner">
    <a href="/" class="brand">Lindsey Liang</a>
    <nav>
      <div class="work-wrap">
        <a href="/" aria-current={isWork ? "page" : undefined}>Work</a>
        <div class="work-menu" role="menu" aria-label="Case studies">
          {caseStudies.map((cs) => (
            <a href={cs.href} role="menuitem" aria-current={path === cs.href ? "page" : undefined}>{cs.label}</a>
          ))}
        </div>
      </div>
      <a href="/about" aria-current={isAbout ? "page" : undefined}>About</a>
      <a href="https://github.com/ziyun-liang" target="_blank" rel="noopener" class="ext">Github<span class="ext-arrow" aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 15px;
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--s-2) var(--s-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand { text-decoration: none; }
  nav { display: flex; gap: var(--s-3); }
  nav a {
    text-decoration: none;
    padding: 0 5px;
    margin: 0 -5px;
  }
  nav a[aria-current="page"] {
    background-image: linear-gradient(
      transparent 20%,
      var(--highlight) 20%,
      var(--highlight) 85%,
      transparent 85%
    );
  }
  .ext-arrow {
    font-size: 0.85em;
    color: var(--ink-muted);
    margin-left: 2px;
    display: inline-block;
    transform: translateY(-1px);
  }

  .work-wrap {
    position: relative;
  }
  .work-menu {
    position: absolute;
    top: 100%;
    left: -12px;
    margin-top: 8px;
    min-width: 220px;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(71, 37, 11, 0.08);
    padding: 8px 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 120ms ease, transform 120ms ease, visibility 120ms;
    z-index: 50;
  }
  .work-wrap:hover .work-menu,
  .work-wrap:focus-within .work-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .work-menu a {
    padding: 6px 16px;
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
    background-image: none;
    white-space: nowrap;
  }
  .work-menu a:hover {
    background-color: var(--rule);
  }
  .work-menu a[aria-current="page"] {
    background-image: linear-gradient(
      transparent 20%,
      var(--highlight) 20%,
      var(--highlight) 85%,
      transparent 85%
    );
    background-size: calc(100% - 32px) 100%;
    background-position: 16px 0;
    background-repeat: no-repeat;
  }
</style>
