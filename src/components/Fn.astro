---
interface Props {
  n: number;
}
const { n } = Astro.props;
---
<sup class="fn-ref" aria-label={`Footnote ${n}`}>{n}</sup>

<style>
  .fn-ref {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.7em;
    font-weight: 500;
    color: var(--accent-coral);
    margin-left: 1px;
    /* sup default vertical-align is super; keep that. */
  }
</style>
