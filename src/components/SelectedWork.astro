---
import type { SelectedWorkEntry } from "../data/selected-work";

interface Props {
  entries: SelectedWorkEntry[];
}
const { entries } = Astro.props;
---

<div class="sw-anchor">
  <section class="sw" data-row-count={entries.length}>
    <div class="sw-image-pane">
      {entries.map((entry, i) => (
        <img
          class={`sw-image-layer ${i === 0 ? "is-visible" : ""}`}
          src={entry.image}
          alt={entry.alt}
          data-index={i}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))}
    </div>
    <ol class="sw-list">
      {entries.map((entry, i) => (
        <li class={`sw-row ${i === 0 ? "is-active" : ""}`} data-index={i}>
          <p class="sw-row-meta">
            <span class="sw-row-client">{entry.client}</span>
            <span class="sw-row-sep"> / </span>
            <span class="sw-row-employer">{entry.employer}</span>
            <span class="sw-row-sep"> · </span>
            <span class="sw-row-year">{entry.year}</span>
          </p>
          <h3 class="sw-row-title"><span class="sw-row-title-mark">{entry.project}</span></h3>
          <p class="sw-row-role">{entry.role}</p>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  .sw-anchor {
    height: 300vh;
  }
  .sw {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    display: flex;
    overflow: hidden;
    background: var(--bg);
  }

  .sw-image-pane {
    position: relative;
    flex: 1 1 50%;
    overflow: hidden;
  }
  .sw-image-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .sw-image-layer.is-visible {
    opacity: 1;
  }

  .sw-list {
    flex: 1 1 50%;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    position: relative;
    will-change: transform;
  }

  .sw-row {
    padding: var(--s-2) var(--s-6);
    border-bottom: 1px solid var(--rule);
  }

  .sw-row-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }
  .sw-row-client { color: var(--ink); }
  .sw-row-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 4px 0;
  }
  .sw-row-title-mark {
    background-image: linear-gradient(
      transparent 20%,
      var(--highlight) 20%,
      var(--highlight) 85%,
      transparent 85%
    );
    background-size: 0% 100%;
    background-repeat: no-repeat;
    padding: 0 4px;
    margin: 0 -4px;
    transition: background-size 280ms ease;
  }
  .sw-row.is-active .sw-row-title-mark {
    background-size: 100% 100%;
  }
  .sw-row-role {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--ink-muted);
  }

  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .sw-anchor {
      height: auto;
    }
    .sw {
      position: static;
      height: auto;
      flex-direction: column;
    }
    .sw-image-pane {
      aspect-ratio: 1 / 1;
      flex: none;
    }
    .sw-list {
      padding: 0;
      overflow: visible;
      transform: none !important;
    }
  }
</style>

<script>
  function initSelectedWork(anchor: HTMLElement) {
    const section = anchor.querySelector(".sw") as HTMLElement;
    const list = section.querySelector(".sw-list") as HTMLElement;
    const rows = Array.from(section.querySelectorAll<HTMLElement>(".sw-row"));
    const images = Array.from(section.querySelectorAll<HTMLElement>(".sw-image-layer"));
    const N = rows.length;
    if (N === 0) return;

    // Preload all images so swaps are instant.
    images.forEach((img) => {
      const real = (img as HTMLImageElement).src;
      if (real) {
        const pre = new Image();
        pre.src = real;
      }
    });

    const mq = window.matchMedia("(max-width: 899px), (prefers-reduced-motion: reduce)");
    if (mq.matches) {
      rows.forEach((row, i) => {
        row.addEventListener("pointerenter", () => {
          images.forEach((img, j) => img.classList.toggle("is-visible", j === i));
        });
      });
      return;
    }

    let scrollActiveIndex = 0;
    let hoverIndex: number | null = null;
    let lastShown = 0;

    function activeIndex() {
      return hoverIndex !== null ? hoverIndex : scrollActiveIndex;
    }

    function showIndex(i: number) {
      if (i === lastShown) return;
      images[lastShown].classList.remove("is-visible");
      rows[lastShown].classList.remove("is-active");
      images[i].classList.add("is-visible");
      rows[i].classList.add("is-active");
      lastShown = i;
    }

    function update() {
      const rect = anchor.getBoundingClientRect();
      const runway = anchor.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / runway));

      // Translate so the bottom of the list reaches the bottom of the section
      // at progress=1. Top rows scroll out the top; bottom rows enter from below.
      const maxTranslate = Math.max(0, list.scrollHeight - section.offsetHeight);
      const currentTranslate = progress * maxTranslate;
      list.style.transform = `translateY(-${currentTranslate}px)`;

      // Active row = whichever row's top is at or just past the section top
      // (i.e. the top-most fully-visible row).
      const rowHeight = rows[0].offsetHeight || 1;
      scrollActiveIndex = Math.min(N - 1, Math.floor(currentTranslate / rowHeight));
      showIndex(activeIndex());
    }

    rows.forEach((row, i) => {
      row.addEventListener("pointerenter", () => {
        hoverIndex = i;
        showIndex(activeIndex());
      });
      row.addEventListener("pointerleave", () => {
        hoverIndex = null;
        showIndex(activeIndex());
      });
    });

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  document.querySelectorAll<HTMLElement>(".sw-anchor").forEach(initSelectedWork);
</script>
