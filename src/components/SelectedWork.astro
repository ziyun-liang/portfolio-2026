---
import type { SelectedWorkEntry } from "../data/selected-work";

interface Props {
  entries: SelectedWorkEntry[];
}
const { entries } = Astro.props;
---

<div class="sw-anchor">
  <section class="sw" data-row-count={entries.length}>
    <div class="sw-image-pane">
      {entries.map((entry, i) => (
        entry.image.endsWith(".mp4") ? (
          <video
            class={`sw-image-layer ${i === 0 ? "is-visible" : ""}`}
            src={entry.image}
            data-index={i}
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            aria-label={entry.alt}
          />
        ) : (
          <img
            class={`sw-image-layer ${i === 0 ? "is-visible" : ""}`}
            src={entry.image}
            alt={entry.alt}
            data-index={i}
            loading={i === 0 ? "eager" : "lazy"}
          />
        )
      ))}
    </div>
    <ol class="sw-list">
      {entries.map((entry, i) => (
        <li class={`sw-row ${i === 0 ? "is-active" : ""}`} data-index={i}>
          <p class="sw-row-meta">
            {entry.url ? (
              <a class="sw-row-link" href={entry.url} target="_blank" rel="noopener">
                <span class="sw-row-project sw-row-project-mark">{entry.project}</span>
                <span class="sw-row-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="sw-row-project sw-row-project-mark">{entry.project}</span>
            )}
            <span class="sw-row-sep"> / </span>
            <span class="sw-row-employer">{entry.employer}</span>
            <span class="sw-row-sep"> • </span>
            <span class="sw-row-year">{entry.year}</span>
          </p>
          <em class="sw-row-role">{entry.role}</em>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  .sw-anchor {
    /* The wrapper exists so existing tests can locate the section. */
  }
  .sw {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    display: flex;
    align-items: flex-start;
    background: var(--bg);
  }

  .sw-image-pane {
    position: sticky;
    top: 0;
    flex: 0 0 50%;
    width: 50%;
    height: 100vh;
    align-self: flex-start;
    overflow: hidden;
  }
  .sw-image-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: var(--s-3);
    box-sizing: border-box;
    object-fit: contain;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .sw-image-layer.is-visible {
    opacity: 1;
  }

  .sw-list {
    flex: 1 1 50%;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sw-row {
    padding: var(--s-3) var(--s-6);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 24px;
    color: var(--ink);
  }
  .sw-row-meta {
    margin: 0;
    flex: 1;
    min-width: 0;
  }
  .sw-row-project {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .sw-row-project-mark {
    background-image: linear-gradient(
      transparent 20%,
      var(--highlight) 20%,
      var(--highlight) 85%,
      transparent 85%
    );
    background-size: 0% 100%;
    background-repeat: no-repeat;
    padding: 0 4px;
    margin: 0 -4px;
    transition: background-size 280ms ease;
  }
  .sw-row.is-active .sw-row-project-mark {
    background-size: 100% 100%;
  }
  .sw-row-link {
    color: inherit;
    text-decoration: none;
  }
  .sw-row-arrow {
    font-size: 0.85em;
    color: var(--ink-muted);
    margin-left: 2px;
    display: inline-block;
    transform: translateY(-1px);
  }
  .sw-row-sep,
  .sw-row-employer,
  .sw-row-year {
    color: var(--ink);
  }
  .sw-row-role {
    font-style: italic;
    flex-shrink: 0;
    text-align: right;
    color: var(--ink);
  }

  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .sw {
      flex-direction: column;
    }
    .sw-image-pane {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      flex: none;
    }
  }
</style>

<script>
  function initSelectedWork(anchor: HTMLElement) {
    const section = anchor.querySelector(".sw") as HTMLElement;
    const rows = Array.from(section.querySelectorAll<HTMLElement>(".sw-row"));
    const images = Array.from(section.querySelectorAll<HTMLElement>(".sw-image-layer"));
    const N = rows.length;
    if (N === 0) return;

    // Preload still images so swaps are instant. Videos are skipped — they
    // already use preload="metadata" and decode lazily when scrolled to.
    images.forEach((el) => {
      if (el.tagName.toLowerCase() !== "img") return;
      const real = (el as HTMLImageElement).src;
      if (real) {
        const pre = new Image();
        pre.src = real;
      }
    });

    let scrollActiveIndex = 0;
    let hoverIndex: number | null = null;
    let lastShown = 0;

    function activeIndex() {
      return hoverIndex !== null ? hoverIndex : scrollActiveIndex;
    }

    function showIndex(i: number) {
      if (i === lastShown) return;
      images[lastShown].classList.remove("is-visible");
      rows[lastShown].classList.remove("is-active");
      images[i].classList.add("is-visible");
      rows[i].classList.add("is-active");
      lastShown = i;
    }

    const mq = window.matchMedia("(max-width: 899px), (prefers-reduced-motion: reduce)");
    if (mq.matches) {
      // Stacked layout: skip scroll-driven swap; only tap-to-swap.
      rows.forEach((row, i) => {
        row.addEventListener("pointerenter", () => {
          hoverIndex = i;
          showIndex(activeIndex());
        });
      });
      return;
    }

    function update() {
      // Active row = the highest-index row whose top has crossed the viewport
      // top (or is right at it). Rows are in document order, so the loop short-
      // circuits as soon as we find one whose top is still below the viewport
      // top.
      let active = 0;
      for (let i = 0; i < N; i++) {
        const top = rows[i].getBoundingClientRect().top;
        if (top <= 0) {
          active = i;
        } else {
          break;
        }
      }
      scrollActiveIndex = active;
      showIndex(activeIndex());
    }

    rows.forEach((row, i) => {
      row.addEventListener("pointerenter", () => {
        hoverIndex = i;
        showIndex(activeIndex());
      });
      row.addEventListener("pointerleave", () => {
        hoverIndex = null;
        showIndex(activeIndex());
      });
    });

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  document.querySelectorAll<HTMLElement>(".sw-anchor").forEach(initSelectedWork);
</script>
