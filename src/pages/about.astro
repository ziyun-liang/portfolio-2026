---
import Base from "../layouts/Base.astro";
const lastUpdated = "May 2026";

const companies = {
  "marco-polo-learning": {
    title: "Marco Polo Learning",
    items: [
      {
        src: "/media/about/marco-polo-learning/01.png",
        alt: "Marco Polo Learning — mobile game gameplay screen",
        caption: "Mobile game design — gameplay, characters, level art.",
      },
      {
        src: "/media/about/marco-polo-learning/02.png",
        alt: "Marco Polo Learning — animation storyboard / character illustration",
        caption: "Character illustration and animation storyboards.",
      },
      {
        src: "/media/about/marco-polo-learning/03.png",
        alt: "Marco Polo Learning — investor deck / TV show concept",
        caption: "Investor decks and TV show concepts.",
      },
    ],
  },
  madwell: {
    title: "Madwell",
    items: [
      {
        src: "/media/about/madwell/01.png",
        alt: "Madwell — advertising campaign work",
        caption: "Advertising campaign — placeholder caption.",
      },
      {
        src: "/media/about/madwell/02.png",
        alt: "Madwell — brand identity",
        caption: "Brand identity — placeholder caption.",
      },
      {
        src: "/media/about/madwell/03.png",
        alt: "Madwell — animation / social",
        caption: "Animated social spot — placeholder caption.",
      },
    ],
  },
  kettle: {
    title: "Kettle",
    items: [
      {
        src: "/media/about/kettle/01.png",
        alt: "Kettle — product design",
        caption: "Product design — placeholder caption.",
      },
      {
        src: "/media/about/kettle/02.png",
        alt: "Kettle — design system",
        caption: "Design system — placeholder caption.",
      },
      {
        src: "/media/about/kettle/03.png",
        alt: "Kettle — visual exploration",
        caption: "Visual exploration — placeholder caption.",
      },
    ],
  },
};
---
<Base title="About — Lindsey Liang">
  <main class="about">
    <header>
      <h1>About</h1>
    </header>

    <section class="bio">
      <p>I'm a product designer. Right now I'm at The New York Times, where I work across advertising, AI-powered search, and editorial summarization — much of what I've shipped lives in the case studies on this site.</p>

      <p>What I value in design is clarity, and craft, and the small moments of delight that simple, consistent design can hold. I enjoy the process. The ideal day for me is one where, after each conversation, brainstorm, or meeting, the idea is sharper than it was before we walked in. That's the bar I set for myself when I'm in the room.</p>

      <p>If I have a magic power, it's speed — being able to pull a clear, simple solution out of a vague idea or a chaotic conversation, and put it on a page so the room can react to it. Product design is visual problem-solving, and at its best it feels a little like driving in the dark with strong partners, figuring out where to go together.</p>

      <p>I came into design through a startup. My first job was at <button class="company" data-company="marco-polo-learning" type="button">Marco Polo Learning</button>, designing and building mobile games alongside the engineers and the CEO without really knowing what I was doing — somehow the company raised $8M during that period.{/* TODO: wrap "$8M" above in <a href="..."> when Lindsey sends the article URL */} I wore a lot of hats: games, illustrations, investor decks, animation storyboards, TV show concepts. It taught me to be useful in any room.</p>

      <p>After that I worked agency-side, first at <button class="company" data-company="madwell" type="button">Madwell</button> and then at <button class="company" data-company="kettle" type="button">Kettle</button>. Across both, the work spanned branding, advertising, animation, social, and product, for clients large and small. The agency era taught me what excellence looks like and built the judgment I now mostly use to critique my own work.</p>

      <p>The last few years at the Times have been different. Bigger teams, more people, more conflict, more impact. The work is slower and the systems are bigger, and a lot of design here is advocacy as much as it is pixels.</p>

      <p>Inside that, a lot of the time I feel like a one-person shop. I meet the colleagues who want to build something, dive in with them, invest the craft and skills I bring, and enjoy the process alongside them. Most of what I've made lately is on this site.</p>
    </section>

    <section class="contact">
      <h2>Contact</h2>
      <ul>
        <li><a href="mailto:hello@example.com">Email</a></li>
        <li><a href="https://www.linkedin.com/in/" rel="me">LinkedIn</a></li>
      </ul>
    </section>

    <p class="updated">Last updated {lastUpdated}.</p>
  </main>

  <dialog id="company-modal" class="company-modal" aria-labelledby="modal-title">
    <header class="modal-header">
      <h2 id="modal-title"></h2>
      <button class="modal-close" type="button" aria-label="Close">×</button>
    </header>
    <div id="modal-stack" class="modal-stack"></div>
  </dialog>
</Base>

<script is:inline define:vars={{ companies }}>
  const modal = document.getElementById("company-modal");
  const titleEl = document.getElementById("modal-title");
  const stackEl = document.getElementById("modal-stack");
  const closeBtn = modal.querySelector(".modal-close");

  function isVideoSrc(src) {
    return /\.(mp4|webm|mov)$/i.test(src);
  }

  function renderStack(category) {
    const data = companies[category];
    if (!data) return;
    titleEl.textContent = data.title;
    stackEl.innerHTML = data.items
      .map((item) => {
        const media = isVideoSrc(item.src)
          ? `<video src="${item.src}" preload="metadata" autoplay loop muted playsinline controls
                    onerror="this.parentElement.classList.add('placeholder'); this.remove();"></video>`
          : `<img src="${item.src}" alt="${item.alt || ""}" loading="lazy"
                  onerror="this.parentElement.classList.add('placeholder'); this.remove();" />`;
        return `<figure class="modal-item">
          ${media}
          ${item.caption ? `<figcaption>${item.caption}</figcaption>` : ""}
        </figure>`;
      })
      .join("");
    // Reset scroll to top when content changes
    stackEl.scrollTop = 0;
  }

  document.querySelectorAll("[data-company]").forEach((btn) => {
    btn.addEventListener("click", () => {
      renderStack(btn.dataset.company);
      modal.showModal();
    });
  });

  closeBtn.addEventListener("click", () => modal.close());

  // Close on backdrop click
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>
  .about {
    max-width: var(--col-center);
    margin: 0 auto;
    padding: var(--s-12) var(--s-4);
  }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--s-6); }
  h2 { font-size: var(--fs-h2); margin: var(--s-8) 0 var(--s-3); }
  .bio p { margin-bottom: var(--s-3); }
  .bio em { font-style: italic; }

  /* Clickable company words — same treatment as the previous discipline triggers */
  .company {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--ink-muted);
    transition: text-decoration-color 150ms ease, color 150ms ease;
  }
  .company:hover,
  .company:focus-visible {
    text-decoration-color: var(--accent, currentColor);
    color: var(--accent, currentColor);
    outline: none;
  }

  .contact ul { display: flex; flex-direction: column; gap: var(--s-1); }
  .contact li { font-family: var(--font-sans); font-size: var(--fs-margin); }
  .updated { font-family: var(--font-sans); font-size: var(--fs-meta); color: var(--ink-muted); margin-top: var(--s-12); }

  /* Modal — sized to match case-study wide-figure pattern */
  .company-modal {
    border: 0;
    border-radius: 8px;
    padding: 0;
    width: min(100vw - 64px, 1216px);
    max-width: 1216px;
    max-height: calc(100vh - 64px);
    background: var(--bg, #fff);
    color: var(--ink, #111);
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .company-modal::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }
  .modal-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--rule);
    background: var(--bg, #fff);
  }
  .modal-header h2 {
    font-size: var(--fs-h3);
    margin: 0;
  }
  .modal-close {
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    background: none;
    border: 0;
    color: var(--ink-muted);
    cursor: pointer;
    padding: 0 var(--s-1);
  }
  .modal-close:hover { color: var(--ink); }

  /* Vertical stack — one item per row, full-width inside modal */
  .modal-stack {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .modal-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .modal-item img,
  .modal-item video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm, 4px);
    background: var(--rule);
  }
  /* When media fails to load, the parent gets .placeholder via onerror */
  .modal-item.placeholder::before {
    content: "";
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(
      45deg,
      var(--rule, #eee),
      var(--rule, #eee) 8px,
      var(--bg, #fff) 8px,
      var(--bg, #fff) 16px
    );
    border-radius: var(--radius-sm, 4px);
  }
  .modal-item figcaption {
    font-family: var(--font-mono);
    font-size: var(--fs-margin);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
    max-width: 60ch;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .company-modal {
      width: calc(100vw - 16px);
      max-height: calc(100vh - 32px);
    }
    .modal-header { padding: var(--s-3) var(--s-4); }
    .modal-stack { padding: var(--s-4); gap: var(--s-5); }
  }
</style>
