---
import Base from "../layouts/Base.astro";
const lastUpdated = "May 2026";

const disciplines = {
  games: {
    title: "Games",
    items: [
      { alt: "Marco Polo mobile game — gameplay screen" },
      { alt: "Marco Polo mobile game — character design" },
      { alt: "Wordle interstitial reference" },
    ],
  },
  illustrations: {
    title: "Illustrations",
    items: [
      { alt: "Editorial illustration — set 1" },
      { alt: "Character illustration" },
      { alt: "Spot illustration" },
    ],
  },
  animation: {
    title: "Animation",
    items: [
      { alt: "Animation storyboard — Marco Polo" },
      { alt: "Motion graphic — agency client" },
      { alt: "Social motion piece" },
    ],
  },
  branding: {
    title: "Branding",
    items: [
      { alt: "Identity system — agency client" },
      { alt: "Logo exploration" },
      { alt: "Brand guidelines spread" },
    ],
  },
  advertising: {
    title: "Advertising",
    items: [
      { alt: "Campaign — agency client" },
      { alt: "Social ad set" },
      { alt: "Out-of-home concept" },
    ],
  },
};
---
<Base title="About — Lindsey Liang">
  <main class="about">
    <header>
      <h1>About</h1>
    </header>

    <section class="bio">
      <p>I'm a product designer. Right now I'm at The New York Times, where I work across advertising, AI-powered search, and editorial summarization — much of what I've shipped lives in the case studies on this site.</p>

      <p>What I value in design is clarity, and craft, and the small moments of delight that simple, consistent design can hold. I enjoy the process. The ideal day for me is one where, after each conversation, brainstorm, or meeting, the idea is sharper than it was before we walked in. That's the bar I set for myself when I'm in the room.</p>

      <p>If I have a magic power, it's speed — being able to pull a clear, simple solution out of a vague idea or a chaotic conversation, and put it on a page so the room can react to it. Product design is visual problem-solving, and at its best it feels a little like driving in the dark with strong partners, figuring out where to go together.</p>

      <p>I came into design through a startup. My first job was at <em>Marco Polo</em>, designing and building mobile <button class="discipline" data-discipline="games" type="button">games</button> alongside the engineers and the CEO without really knowing what I was doing — somehow the company raised $8M during that period. I wore a lot of hats: <button class="discipline" data-discipline="games" type="button">games</button>, <button class="discipline" data-discipline="illustrations" type="button">illustrations</button>, investor decks, <button class="discipline" data-discipline="animation" type="button">animation storyboards</button>, TV show concepts. It taught me to be useful in any room.</p>

      <p>After that I worked agency-side — <button class="discipline" data-discipline="branding" type="button">branding</button>, <button class="discipline" data-discipline="advertising" type="button">advertising</button>, <button class="discipline" data-discipline="animation" type="button">animation</button>, social, product, with big and small clients. The agency era taught me what excellence looks like and built the judgment I now mostly use to critique my own work.</p>

      <p>The last few years at the Times have been different. Bigger teams, more people, more conflict, more impact. The work is slower and the systems are bigger, and a lot of design here is advocacy as much as it is pixels.</p>

      <p>Inside that, a lot of the time I feel like a one-person shop. I meet the colleagues who want to build something, dive in with them, invest the craft and skills I bring, and enjoy the process alongside them. Most of what I've made lately is on this site.</p>
    </section>

    <section class="contact">
      <h2>Contact</h2>
      <ul>
        <li><a href="mailto:hello@example.com">Email</a></li>
        <li><a href="https://www.linkedin.com/in/" rel="me">LinkedIn</a></li>
      </ul>
    </section>

    <p class="updated">Last updated {lastUpdated}.</p>
  </main>

  <dialog id="discipline-modal" class="discipline-modal" aria-labelledby="modal-title">
    <header class="modal-header">
      <h2 id="modal-title"></h2>
      <button class="modal-close" type="button" aria-label="Close">×</button>
    </header>
    <div id="modal-grid" class="modal-grid"></div>
  </dialog>
</Base>

<script is:inline define:vars={{ disciplines }}>
  const modal = document.getElementById("discipline-modal");
  const titleEl = document.getElementById("modal-title");
  const gridEl = document.getElementById("modal-grid");
  const closeBtn = modal.querySelector(".modal-close");

  function renderGrid(category) {
    const data = disciplines[category];
    if (!data) return;
    titleEl.textContent = data.title;
    gridEl.innerHTML = data.items
      .map((item, i) => {
        const src = `/media/about/${category}/${String(i + 1).padStart(2, "0")}.png`;
        // Render as <img>; if file is missing the img.onerror handler swaps to a placeholder.
        return `<figure class="modal-item">
          <img src="${src}" alt="${item.alt}" loading="lazy"
               onerror="this.parentElement.classList.add('placeholder'); this.remove();" />
          <figcaption>${item.alt}</figcaption>
        </figure>`;
      })
      .join("");
  }

  document.querySelectorAll("[data-discipline]").forEach((btn) => {
    btn.addEventListener("click", () => {
      renderGrid(btn.dataset.discipline);
      modal.showModal();
    });
  });

  closeBtn.addEventListener("click", () => modal.close());

  // Close on backdrop click
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>
  .about {
    max-width: var(--col-center);
    margin: 0 auto;
    padding: var(--s-12) var(--s-4);
  }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--s-6); }
  h2 { font-size: var(--fs-h2); margin: var(--s-8) 0 var(--s-3); }
  .bio p { margin-bottom: var(--s-3); }
  .bio em { font-style: italic; }

  /* Clickable discipline words */
  .discipline {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--ink-muted);
    transition: text-decoration-color 150ms ease, color 150ms ease;
  }
  .discipline:hover,
  .discipline:focus-visible {
    text-decoration-color: var(--accent, currentColor);
    color: var(--accent, currentColor);
    outline: none;
  }

  .contact ul { display: flex; flex-direction: column; gap: var(--s-1); }
  .contact li { font-family: var(--font-sans); font-size: var(--fs-margin); }
  .updated { font-family: var(--font-sans); font-size: var(--fs-meta); color: var(--ink-muted); margin-top: var(--s-12); }

  /* Modal */
  .discipline-modal {
    border: 0;
    border-radius: 8px;
    padding: 0;
    max-width: 720px;
    width: calc(100% - 2 * var(--s-4));
    background: var(--bg, #fff);
    color: var(--ink, #111);
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.18);
  }
  .discipline-modal::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .modal-header h2 {
    font-size: var(--fs-h3);
    margin: 0;
  }
  .modal-close {
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    background: none;
    border: 0;
    color: var(--ink-muted);
    cursor: pointer;
    padding: 0 var(--s-1);
  }
  .modal-close:hover { color: var(--ink); }

  .modal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--s-3);
    padding: var(--s-4);
  }
  .modal-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .modal-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--rule);
    border-radius: 4px;
    display: block;
  }
  /* When the image fails to load, the parent gets .placeholder via onerror */
  .modal-item.placeholder::before {
    content: "";
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: repeating-linear-gradient(
      45deg,
      var(--rule, #eee),
      var(--rule, #eee) 8px,
      var(--bg, #fff) 8px,
      var(--bg, #fff) 16px
    );
    border-radius: 4px;
  }
  .modal-item figcaption {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }
</style>
