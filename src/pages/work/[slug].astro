---
import { getCollection, render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? { href: `/work/${entries[i - 1].id}`, title: entries[i - 1].data.title } : undefined,
      next: i < entries.length - 1 ? { href: `/work/${entries[i + 1].id}`, title: entries[i + 1].data.title } : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));
---
<CaseStudy
  title={entry.data.title}
  dek={entry.data.dek}
  myRole={entry.data.myRole}
  corePartners={entry.data.corePartners}
  timeframe={entry.data.timeframe}
  sections={sections}
  prev={prev}
  next={next}
>
  <Content />
</CaseStudy>
