---
import { getCollection, getEntry, render } from "astro:content";
import CaseStudy from "../../layouts/CaseStudy.astro";

const { slug } = Astro.params;
const entry = slug ? await getEntry("work", slug) : undefined;
if (!entry) return new Response(null, { status: 404 });

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((e) => e.id === entry.id);
const prev = i > 0 ? { href: `/work/${all[i - 1].id}`, title: all[i - 1].data.title } : undefined;
const next = i < all.length - 1 ? { href: `/work/${all[i + 1].id}`, title: all[i + 1].data.title } : undefined;

const { Content, headings } = await render(entry);
const sections = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));
---
<CaseStudy
  title={entry.data.title}
  dek={entry.data.dek}
  myRole={entry.data.myRole}
  corePartners={entry.data.corePartners}
  timeframe={entry.data.timeframe}
  sections={sections}
  prev={prev}
  next={next}
>
  <Content />
</CaseStudy>
