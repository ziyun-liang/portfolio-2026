---
import Base from "../layouts/Base.astro";
const lastUpdated = "May 2026";

const experience = [
  {
    company: "The New York Times",
    location: "New York",
    roles: [
      {
        title: "Lead Product Designer, AI Products & Platforms",
        from: "Jan 2026",
        to: "Present",
        description: "Leading design for AI-powered editorial products — search, summarization, and personalization.",
      },
      {
        title: "Lead Product Designer, Advertising",
        from: "Mar 2023",
        to: "Jan 2026",
        description: "Led design across NYT's ad business — bundle expansion (Games, Cooking, Wirecutter, The Athletic, News), the native ad format catalog, the video format spec, and the AI-augmented ad-ops platform.",
      },
      {
        title: "Senior Product Designer, Advertising",
        from: "Sep 2021",
        to: "Feb 2023",
        description: "First product designer on the Ad Mission team. Helped introduce advertising to The Athletic; built the design practice on a 60-person, mostly-PM team.",
      },
    ],
  },
  {
    company: "Kettle",
    location: "New York",
    roles: [
      {
        title: "Senior Product Designer",
        from: "Sep 2019",
        to: "Sep 2021",
        description: "",
      },
    ],
  },
  {
    company: "Madwell",
    location: "New York",
    roles: [
      {
        title: "Product Designer",
        from: "Feb 2018",
        to: "Sep 2019",
        description: "",
      },
    ],
  },
  {
    company: "MarcoPolo Learning",
    location: "New York",
    roles: [
      {
        title: "Lead Product Designer",
        from: "Dec 2015",
        to: "Jan 2018",
        description: "",
      },
    ],
  },
];
---
<Base title="CV — Lindsey Liang">
  <main class="cv">
    <header>
      <h1>CV</h1>
      <p class="meta">Lindsey Liang · New York · <a href="/about">About</a> · <a href="/">Work</a></p>
    </header>

    <section class="experience">
      <h2>Experience</h2>
      <ol class="company-list">
        {experience.map((entry) => (
          <li class="company-block">
            <header class="company">
              <div class="company-name">{entry.company}</div>
              <div class="company-loc">{entry.location}</div>
            </header>
            <ol class="company-roles">
              {entry.roles.map((role) => (
                <li class="role">
                  <div class="role-dates">{role.from} – {role.to}</div>
                  <div class="role-body">
                    <div class="role-title">{role.title}</div>
                    {role.description && <p class="role-desc">{role.description}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </section>

    <section class="education">
      <h2>Education</h2>
      <p class="placeholder">Education to add — send school, degree, and dates and I'll wire them in.</p>
    </section>

    <p class="updated">Last updated {lastUpdated}.</p>
  </main>
</Base>

<style>
  .cv {
    max-width: var(--col-center);
    margin: 0 auto;
    padding: var(--s-12) var(--s-4);
  }
  h1 { font-size: var(--fs-h1); margin-bottom: var(--s-2); }
  h2 { font-size: var(--fs-h2); margin: var(--s-8) 0 var(--s-4); }
  .meta {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }
  .meta a { color: inherit; }

  .company-list { list-style: none; padding: 0; margin: 0; }
  .company-block + .company-block {
    margin-top: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .company { font-family: var(--font-sans); margin-bottom: var(--s-3); }
  .company-name { font-weight: 500; font-size: var(--fs-h3); }
  .company-loc {
    font-size: var(--fs-meta);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .company-roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .role {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--s-3);
    align-items: start;
  }
  .role-dates {
    font-family: var(--font-sans);
    font-size: var(--fs-margin);
    color: var(--ink-muted);
    padding-top: 2px;
  }
  .role-title { font-weight: 500; }
  .role-desc { margin: var(--s-1) 0 0; line-height: var(--lh-normal); }

  .placeholder {
    font-family: var(--font-sans);
    font-size: var(--fs-margin);
    color: var(--ink-muted);
    font-style: italic;
  }
  .updated {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
    margin-top: var(--s-12);
  }

  @media (max-width: 600px) {
    .role { grid-template-columns: 1fr; gap: var(--s-1); }
  }
</style>
